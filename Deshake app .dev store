<script>

  /*
   * ==========================================
   * DESHAKE AI TUTOR
   * ==========================================
   *
   * Existing Deshake Worker endpoint.
   *
   * IMPORTANT:
   * No API key is placed in this frontend.
   */

  const AI_WORKER =
    "https://floral-poetry-5fcb.anu315300.workers.dev";


  function escapeHTML(value) {

    const div = document.createElement("div");

    div.textContent = value;

    return div.innerHTML;

  }


  async function askTutor() {

    const question =
      document.getElementById("question").value.trim();

    const answer =
      document.getElementById("answer");


    if (!question) {

      answer.textContent =
        "कृपया पहले अपना सवाल लिखिए।";

      return;

    }


    answer.innerHTML =
      "🤖 Deshake AI जवाब तैयार कर रहा है…";


    try {

      const response = await fetch(
        AI_WORKER,
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify({
            question: question
          })
        }
      );


      if (!response.ok) {

        throw new Error(
          "AI Worker अभी सही response नहीं दे रहा है।"
        );

      }


      const data =
        await response.json();


      if (!data.success) {

        throw new Error(
          data.error ||
          "AI उत्तर उपलब्ध नहीं है।"
        );

      }


      const text =
        data.answer ||
        "AI ने कोई उत्तर नहीं दिया।";


      answer.innerHTML =

        "<strong>🤖 Deshake AI Tutor</strong>" +

        "<p>" +
        escapeHTML(text) +
        "</p>" +

        "<button class='button' onclick='speakAIAnswer()'>" +
        "🔊 जवाब सुनें" +
        "</button>";

    }

    catch (error) {

      answer.innerHTML =

        "<strong>⚠️ AI Tutor अभी उपलब्ध नहीं है</strong>" +

        "<p>" +
        escapeHTML(error.message) +
        "</p>" +

        "<p>" +
        "नीचे की Voice सुविधा अलग से काम कर सकती है।" +
        "</p>";

    }

  }


  function speakAIAnswer() {

    const paragraph =
      document.querySelector("#answer p");


    if (!paragraph) {
      return;
    }


    document.getElementById("voiceText").value =
      paragraph.textContent;


    document.getElementById("voice")
      .scrollIntoView({
        behavior: "smooth",
        block: "center"
      });


    setTimeout(
      speakText,
      300
    );

  }


  /*
   * ==========================================
   * DESHAKE VOICE
   * ==========================================
   *
   * Browser/device Text-to-Speech.
   *
   * This is intentionally API-key free.
   */

  let availableVoices = [];


  function loadVoices() {

    if (!("speechSynthesis" in window)) {

      document.getElementById("voiceStatus")
        .textContent =
        "इस browser/device में Text-to-Speech उपलब्ध नहीं है।";

      return;

    }


    availableVoices =
      window.speechSynthesis.getVoices();


    const select =
      document.getElementById("voiceSelect");


    select.innerHTML = "";


    const hindiVoices =
      availableVoices.filter(
        voice =>
          /^hi[-_]/i.test(voice.lang) ||
          /hindi/i.test(voice.name)
      );


    const englishVoices =
      availableVoices.filter(
        voice =>
          /^en[-_]/i.test(voice.lang)
      );


    const otherVoices =
      availableVoices.filter(
        voice =>
          !hindiVoices.includes(voice) &&
          !englishVoices.includes(voice)
      );


    const orderedVoices = [
      ...hindiVoices,
      ...englishVoices,
      ...otherVoices
    ];


    orderedVoices.forEach(
      voice => {

        const option =
          document.createElement("option");


        option.value =
          availableVoices.indexOf(voice);


        option.textContent =
          voice.name +
          " (" +
          voice.lang +
          ")";


        select.appendChild(option);

      }
    );


    if (hindiVoices.length) {

      select.value =
        String(
          availableVoices.indexOf(
            hindiVoices[0]
          )
        );

    }


    document.getElementById("voiceStatus")
      .textContent =
      orderedVoices.length
        ? "Voice तैयार है।"
        : "Device की default voice इस्तेमाल होगी।";

  }


  function speakText() {

    if (!("speechSynthesis" in window)) {

      alert(
        "आपके browser/device में Text-to-Speech उपलब्ध नहीं है।"
      );

      return;

    }


    const text =
      document.getElementById("voiceText")
        .value.trim();


    if (!text) {

      alert(
        "पहले सुनने के लिए text लिखिए।"
      );

      return;

    }


    window.speechSynthesis.cancel();


    const utterance =
      new SpeechSynthesisUtterance(text);


    const selected =
      document.getElementById("voiceSelect")
        .value;


    if (
      selected !== "" &&
      availableVoices[selected]
    ) {

      utterance.voice =
        availableVoices[selected];

    }


    utterance.rate =
      parseFloat(
        document.getElementById("voiceRate")
          .value
      ) || 0.9;


    utterance.pitch = 1;
    utterance.volume = 1;


    utterance.onstart =
      function () {

        document.getElementById("voiceStatus")
          .textContent =
          "🔊 आवाज़ चल रही है…";

      };


    utterance.onend =
      function () {

        document.getElementById("voiceStatus")
          .textContent =
          "✅ Voice पूरी हो गई।";

      };


    utterance.onerror =
      function () {

        document.getElementById("voiceStatus")
          .textContent =
          "⚠️ Voice चल नहीं पाई।";

      };


    window.speechSynthesis
      .speak(utterance);

  }


  function pauseVoice() {

    if (
      "speechSynthesis" in window &&
      window.speechSynthesis.speaking
    ) {

      window.speechSynthesis.pause();

    }

  }


  function resumeVoice() {

    if (
      "speechSynthesis" in window &&
      window.speechSynthesis.paused
    ) {

      window.speechSynthesis.resume();

    }

  }


  function stopVoice() {

    if (
      "speechSynthesis" in window
    ) {

      window.speechSynthesis.cancel();

    }


    document.getElementById("voiceStatus")
      .textContent =
      "⏹️ Voice रोक दी गई।";

  }


  if (
    "speechSynthesis" in window
  ) {

    loadVoices();

    window.speechSynthesis.onvoiceschanged =
      loadVoices;

  }

</script>

