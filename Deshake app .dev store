    </div>


    <!-- VOICE -->

    <div class="voice-box" id="voice">

      <h3>🔊 Deshake AI Voice</h3>

      <p>
        किसी text को अपने फोन की उपलब्ध Hindi/English voice में सुनें।
      </p>

      <textarea id="voiceText">नमस्ते! Deshake में आपका स्वागत है। सीखिए, अपना काम शुरू कीजिए और आगे बढ़िए।</textarea>

      <div class="voice-controls">

        <div>
          <label>
            <strong>Voice</strong>
          </label>

          <select id="voiceSelect">
            <option>Voice लोड हो रही है...</option>
