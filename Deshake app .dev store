<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#123B78">

  <title>Deshake | गाँव से अपना काम</title>

  <style>
    :root {
      --blue: #123b78;
      --blue-dark: #08244d;
      --gold: #d6a83b;
      --cream: #fffaf0;
      --white: #ffffff;
      --text: #172033;
      --muted: #626b7a;
      --border: #eadfca;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, "Noto Sans Devanagari", sans-serif;
      background: var(--cream);
      color: var(--text);
      line-height: 1.6;
    }

    header {
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
      color: white;
      text-align: center;
      padding: 34px 18px;
      border-bottom: 4px solid var(--gold);
    }

    header h1 {
      margin: 0;
      font-size: 38px;
    }

    header p {
      margin: 8px 0 0;
      font-size: 17px;
    }

    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: white;
      padding: 10px 8px;
      text-align: center;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    nav a {
      color: var(--blue);
      text-decoration: none;
      font-weight: bold;
      margin: 4px 7px;
      font-size: 14px;
    }

    nav a:hover {
      color: #9b7417;
    }

    .hero {
      text-align: center;
      padding: 50px 18px 40px;
    }

    .hero h2 {
      color: var(--blue);
      font-size: 30px;
      margin: 0 0 12px;
    }

    .hero p {
      max-width: 760px;
      margin: 10px auto;
      font-size: 18px;
    }

    .section {
      max-width: 1050px;
      margin: auto;
      padding: 28px 16px;
    }

    .card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      box-shadow: 0 5px 22px rgba(0,0,0,.06);
      margin-bottom: 20px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .feature {
      background: white;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      text-align: center;
    }

    .icon {
      font-size: 34px;
    }

    h2,
    h3 {
      color: var(--blue);
    }

    textarea,
    select {
      width: 100%;
      border: 1px solid #c9cdd4;
      border-radius: 10px;
      padding: 13px;
      font: inherit;
      background: white;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    .button {
      display: inline-block;
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      margin: 5px 3px;
      background: var(--blue);
      color: white;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
    }

    .button.gold {
      background: #9b7417;
    }

    .button.light {
      background: #edf3fa;
      color: var(--blue);
      border: 1px solid #ccd9e8;
    }

    .answer {
      background: #f5f9ff;
      border-left: 5px solid var(--blue);
      padding: 16px;
      border-radius: 10px;
      margin-top: 16px;
      min-height: 55px;
    }

    .voice-box {
      margin-top: 22px;
      padding: 20px;
      background: #fff8e5;
      border: 1px solid #ead18a;
      border-top: 4px solid var(--gold);
      border-radius: 16px;
    }

    .voice-controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 10px;
    }

    .status {
      color: var(--muted);
      font-size: 14px;
      margin-top: 8px;
    }

    .steps {
      margin-top: 15px;
    }

    .step {
      background: white;
      border-left: 5px solid var(--blue);
      border-radius: 10px;
      padding: 14px;
      margin: 10px 0;
    }

    footer {
      background: var(--blue);
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 25px;
      border-top: 4px solid var(--gold);
    }

    @media (max-width: 700px) {
      header h1 {
        font-size: 30px;
      }

      .hero h2 {
        font-size: 25px;
      }

      .grid {
        grid-template-columns: 1fr 1fr;
      }

      .voice-controls {
        grid-template-columns: 1fr;
      }

      nav a {
        font-size: 13px;
        margin: 3px;
      }
    }

    @media (max-width: 430px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

