<script>

let steps = [];
let completed = 0;

function createPlan() {

  const goal = document.getElementById("goal").value.trim();

  if (!goal) {
    alert("पहले अपना काम लिखिए।");
    return;
  }

  steps = [
    "अपने काम को समझें और जरूरी सामग्री तैयार करें।",
    "काम का पहला छोटा हिस्सा पूरा करें।",
    "अपने काम को जाँचें और गलती सुधारें।",
    "अगला हिस्सा पूरा करें।",
    "पूरे काम की दोबारा समीक्षा करें।",
    "अंतिम जाँच करें और अपना काम पूरा करें।"
  ];

  completed = 0;

  showSteps(goal);
}


function showSteps(goal) {

  let html = "";

  html += "<h3>🎯 आपका Goal</h3>";
  html += "<p><strong>" + escapeHtml(goal) + "</strong></p>";

  html += "<p>Progress: <span id='percent'>0%</span></p>";

  html += `
    <div class="progress">
      <div class="progress-bar" id="progressBar"></div>
    </div>
  `;

  steps.forEach(function(step, index) {

    html += `
      <div class="step" id="step-${index}">
        <strong>Step ${index + 1}</strong>
        <p>${step}</p>
        <button onclick="completeStep(${index})">
          यह Step पूरा हुआ
        </button>
      </div>
    `;

  });

  html += "<div id='completeMessage'></div>";

  document.getElementById("result").innerHTML = html;
}


function completeStep(index) {

  const step = document.getElementById("step-" + index);

  if (step.dataset.completed === "true") {
    return;
  }

  step.dataset.completed = "true";

  step.style.opacity = "0.55";

  completed++;

  const percent = Math.round((completed / steps.length) * 100);

  document.getElementById("percent").innerText = percent + "%";

  document.getElementById("progressBar").style.width = percent + "%";

  if (completed === steps.length) {

    document.getElementById("completeMessage").innerHTML = `
      <div class="card">
        <h2>🎉 काम पूरा हो गया!</h2>
        <p>
          आपने अपना पूरा Goal पूरा कर लिया।
        </p>
        <strong>100% Complete</strong>
      </div>
    `;

  }

}


function escapeHtml(text) {

  const div = document.createElement("div");

  div.innerText = text;

  return div.innerHTML;

}

</script>

